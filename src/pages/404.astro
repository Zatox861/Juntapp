---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada (404) | Juntapp">
  <div class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4 relative">
    <div class="absolute inset-0 z-0 pointer-events-none">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[30rem] h-[30rem] bg-primary/10 rounded-full blur-[140px]"></div>
    </div>

    <div class="relative z-10 glass-panel rounded-3xl p-8 md:p-14 max-w-lg w-full flex flex-col items-center border border-white/10 shadow-2xl">
      <div class="w-20 h-20 bg-primary/20 rounded-2xl flex items-center justify-center text-4xl mb-6 border border-primary/30 shadow-[0_0_20px_rgba(168,85,247,0.3)]">
        🎲
      </div>
      <h1 class="font-display-lg text-6xl md:text-7xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary tracking-tighter mb-2">
        404
      </h1>
      <h2 class="text-xl md:text-2xl font-bold text-white mb-3">
        ¡Te fuiste a otra fiesta!
      </h2>
      <p class="text-on-surface-variant text-sm mb-8 leading-relaxed max-w-sm">
        Esta sala o página no existe o fue eliminada. Regresa al catálogo para seguir jugando.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 w-full">
        <a href="/play" class="flex-1 py-3.5 px-6 bg-gradient-to-r from-primary to-secondary text-white font-bold rounded-xl shadow-[0_0_25px_rgba(168,85,247,0.3)] hover:scale-105 active:scale-95 transition-all text-center">
          Ver Juegos
        </a>
        <a href="/" class="flex-1 py-3.5 px-6 bg-white/5 hover:bg-white/10 text-white font-semibold rounded-xl border border-white/10 transition-colors text-center">
          Ir al Inicio
        </a>
      </div>
    </div>
  </div>
</Layout>
