---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Ruleta de la Suerte | Juntapp">
  <div class="min-h-screen bg-transparent flex flex-col font-sans overflow-x-hidden">
    <div class="relative z-10 flex flex-col flex-grow w-full max-w-5xl mx-auto p-4 md:p-8">
      <!-- HEADER UNIVERSAL -->
      <header class="relative flex justify-between items-center mb-8 md:mb-12 w-full z-20">
        <a href="/play" id="back-btn" class="flex items-center gap-2 text-zinc-400 hover:text-white transition-colors text-sm font-medium z-10" title="Volver al Catálogo">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          <span class="hidden sm:inline">Volver</span>
        </a>
        
        <div class="absolute left-1/2 -translate-x-1/2 flex flex-col items-center w-full pointer-events-none">
          <h1 class="text-xl md:text-2xl font-geist font-bold text-transparent bg-clip-text bg-gradient-to-r from-vybe-secondary to-vybe-primary uppercase tracking-tighter text-center">
            Ruleta
          </h1>
          <span class="text-[10px] font-mono bg-white/10 px-2 py-0.5 mt-1 rounded text-vybe-primary pointer-events-auto" id="display-room"></span>
        </div>

        <button id="btn-info" class="flex items-center gap-2 text-zinc-400 hover:text-white transition-colors text-sm font-medium z-10" title="Cómo jugar">
          <span class="hidden sm:inline">Cómo jugar</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        </button>
      </header>

      <main class="flex flex-col md:flex-row gap-8 items-center md:items-start justify-center flex-grow z-10 w-full">
      
      <!-- Controles y Nombres -->
      <div class="glass-panel p-8 rounded-3xl w-full max-w-sm order-2 md:order-1 flex flex-col shadow-2xl border-white/5">
        <!-- Panel de Resultado (Ahora en la parte superior para UX) -->
        <div class="bg-secondary/10 p-5 rounded-2xl border border-secondary/30 mb-8 shadow-[0_0_20px_rgba(0,234,255,0.1)]">
          <p class="text-[10px] uppercase tracking-[0.2em] text-vybe-secondary font-bold mb-2 text-center">Ganador / Castigo</p>
          <div id="result-display" class="text-2xl font-black text-white text-center h-10 flex items-center justify-center neon-text-secondary">
            --
          </div>
        </div>

        <div class="mb-6 flex flex-col flex-grow overflow-hidden">
          <div class="mb-4">
            <h2 class="text-xl font-geist font-bold text-white flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-vybe-primary"></span>
              Opciones
            </h2>
            <p class="text-xs text-vybe-text-muted mt-1.5 leading-relaxed">
              Configura los premios, castigos o nombres (máx 20).
            </p>
          </div>

          <!-- Botón Cargar Jugadores del Grupo -->
          <button 
            id="btn-load-party-players" 
            type="button" 
            class="w-full py-2.5 px-3 bg-gradient-to-r from-primary/15 to-secondary/15 hover:from-primary/25 hover:to-secondary/25 border border-primary/30 rounded-xl text-primary hover:text-white transition-all flex items-center justify-between text-xs font-bold mb-3 cursor-pointer shadow-sm group"
            title="Cargar los nombres de amigos configurados en la junta"
          >
            <span class="flex items-center gap-1.5">
              <span>👥</span>
              <span>Cargar amigos del grupo</span>
            </span>
            <span class="px-2 py-0.5 rounded-full bg-primary/20 text-primary font-mono text-[11px] group-hover:bg-primary group-hover:text-black transition-colors" data-party-count>0</span>
          </button>
          
          <!-- Contenedor de Casillas Dinámicas -->
          <div id="options-container" class="space-y-2 mb-4 overflow-y-auto pr-2 custom-scrollbar max-h-[180px] md:max-h-none">
            <!-- Se generarán aquí -->
          </div>

          <button id="add-option" class="w-full py-2 border border-dashed border-white/20 rounded-lg text-vybe-text-muted hover:text-vybe-secondary hover:border-vybe-secondary/50 transition-all flex items-center justify-center gap-2 text-xs font-bold mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            AGREGAR OPCIÓN
          </button>

          <button id="btn-spin-alt" class="w-full bg-primary text-black py-3 rounded-lg font-bold hover:scale-[1.02] transition-transform mb-6 shadow-[0_0_20px_rgba(0,234,255,0.3)]">
            ¡GIRAR AHORA!
          </button>

        </div>
      </div>

      <!-- Ruleta Visual -->
      <div class="relative flex-shrink-0 w-[20rem] h-[20rem] sm:w-[26rem] sm:h-[26rem] md:w-[32rem] md:h-[32rem] order-1 md:order-2">
        
        <!-- Puntero Metálico/Neón -->
        <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-8 z-50 drop-shadow-[0_5px_10px_rgba(0,0,0,0.7)]">
          <svg width="46" height="58" viewBox="0 0 32 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M16 40L0 0H32L16 40Z" fill="#d1d5db" stroke="#6b7280" stroke-width="2" stroke-linejoin="round"/>
            <path d="M16 34L6 6H26L16 34Z" fill="#ffffff" filter="drop-shadow(0 0 6px #ffffff)"/>
          </svg>
        </div>
        
        <!-- Rueda Estilo Arcade/Cyberpunk -->
        <div id="wheel-container" class="relative w-full h-full rounded-full shadow-[0_0_60px_rgba(0,234,255,0.2)]">
           <div id="wheel" class="relative w-full h-full rounded-full overflow-hidden transition-transform duration-[4000ms] ease-[cubic-bezier(0.2,0.8,0.2,1)] flex items-center justify-center">
            <!-- El contenido de la rueda SVG se generará aquí -->
          </div>
        </div>

        <!-- Botón Central Neón v6 (Estilo Glow) -->
        <button id="btn-spin" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[72px] h-[72px] rounded-full z-40
          border-[4px] border-[#9ca3af] flex items-center justify-center group active:scale-95 transition-all cursor-pointer
          shadow-[0_0_20px_rgba(0,234,255,0.3),inset_0_0_15px_rgba(0,0,0,0.5)]"
          style="background: radial-gradient(circle, #002233 0%, #001122 100%);">
           <span class="text-[#00eaff] font-black text-[17px] leading-none tracking-tighter uppercase" 
                 style="text-shadow: 0 0 8px #00eaff, 0 0 15px rgba(0,234,255,0.6);">
             GIRAR
           </span>
        </button>
      </div>
    </div>

    <!-- Modal Instrucciones -->
    <div id="info-modal" class="hidden fixed inset-0 z-50 items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-in fade-in duration-300">
      <div class="glass-panel relative w-full max-w-md rounded-[32px] p-8 border border-white/10 shadow-2xl bg-[#121215] text-left">
        <button id="btn-close-info" class="absolute top-6 right-6 text-zinc-400 hover:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
        
        <h3 class="text-2xl font-black text-white mb-6 flex items-center gap-3">
          <span class="text-vybe-primary">ℹ️</span> Cómo Jugar
        </h3>
        
        <div class="space-y-5 text-sm text-zinc-300 leading-relaxed">
          <p><strong>1. Configuración:</strong> Agrega los nombres de los participantes o los castigos en la lista de opciones (Máximo 20).</p>
          
          <p><strong>2. Acción:</strong> Haz clic en el botón central de "GIRAR" o en el botón "¡GIRAR AHORA!" para hacer rodar la ruleta.</p>
          
          <p><strong>3. Resultado:</strong> La ruleta seleccionará al azar una de las opciones ingresadas.</p>
          
          <p><strong>4. Edición:</strong> Puedes eliminar opciones con la 'X' o agregar nuevas en cualquier momento.</p>
        </div>
        
        <button id="btn-understood" class="mt-8 w-full py-4 rounded-2xl bg-white/10 border border-white/20 text-white font-bold hover:bg-white/20 transition-all active:scale-95">
          ¡Entendido!
        </button>
      </div>
        <!-- SEO & Contenido Largo (Below the fold) -->
        <article class="w-full max-w-4xl mx-auto px-4 py-12 mt-12 md:mt-16 border-t border-white/10 text-zinc-300 text-left">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Ruleta Interactiva para Tomar Decisiones</h2>
          <div class="prose prose-invert prose-lg max-w-none">
            <p class="mb-4">
              ¿No saben qué beber, a quién le toca o qué hacer a continuación? La <strong>Ruleta de la Suerte</strong> es la solución perfecta. Olvídate de discutir o echarlo a la suerte con una moneda; nuestra ruleta digital decide por ti de forma justa, rápida y con un toque de emoción gracias a sus animaciones visuales inmersivas.
            </p>
            <h3 class="text-2xl font-bold text-white mt-8 mb-4">¿Cómo usar la Ruleta?</h3>
            <ul class="list-disc pl-6 space-y-2 mb-6">
              <li>Elige la temática usando los filtros: puedes hacer una ruleta de Castigos, Retos o un modo Clásico para elegir personas al azar.</li>
              <li>Presiona "Girar" en el centro de la rueda.</li>
              <li>La rueda girará con física y fricción realista. ¡Espera con tensión el resultado!</li>
            </ul>
            <h3 class="text-2xl font-bold text-white mt-8 mb-4">Preguntas Frecuentes (FAQ)</h3>
            <div class="space-y-4 mb-8">
              <div class="bg-white/5 border border-white/10 rounded-xl p-4">
                <h4 class="font-bold text-white mb-1">¿Puedo personalizar las opciones de la ruleta?</h4>
                <p class="text-sm">Nuestra aplicación ofrece categorías predefinidas con cientos de opciones seleccionadas cuidadosamente para garantizar la diversión instantánea en cualquier junta, ahorrándote el tiempo de configurar la rueda.</p>
              </div>
              <div class="bg-white/5 border border-white/10 rounded-xl p-4">
                <h4 class="font-bold text-white mb-1">¿La selección es realmente aleatoria?</h4>
                <p class="text-sm">Totalmente. El motor de físicas calcula una velocidad inicial y fricción generadas por algoritmos criptográficos que garantizan que el resultado no pueda ser manipulado ni predecido por ningún jugador.</p>
              </div>
            </div>
          </div>
        </article>
      </main>
    </div>
  </div>
</Layout>

<script>
  import { createSeededRandom } from '../../utils/random';
  import { getPlayers, onPlayersChange } from '../../utils/players';

  const urlParams = new URLSearchParams(window.location.search);
  let localSeed = localStorage.getItem('juntapp_local_seed');
  if (!localSeed) {
    localSeed = Math.random().toString(36).substring(2, 6).toUpperCase();
    localStorage.setItem('juntapp_local_seed', localSeed);
  }
  const seed = urlParams.get('seed') || localSeed;
  
  const displayRoom = document.getElementById('display-room');
  if (displayRoom) {
    displayRoom.innerText = urlParams.has('seed') ? `Sala: ${seed}` : `Local`;
  }
  
  const backBtn = document.getElementById('back-btn');
  if (backBtn) {
    backBtn.setAttribute('href', urlParams.has('seed') ? `/play?seed=${seed}` : `/play`);
  }

  const optionsContainer = document.getElementById('options-container');
  const addOptionBtn = document.getElementById('add-option');
  const btnSpin = document.getElementById('btn-spin');
  const btnSpinAlt = document.getElementById('btn-spin-alt');
  const wheel = document.getElementById('wheel');
  const resultDisplay = document.getElementById('result-display');
  
  // Modal logic
  const infoModal = document.getElementById('info-modal');
  const btnInfo = document.getElementById('btn-info');
  const btnCloseInfo = document.getElementById('btn-close-info');
  const btnUnderstood = document.getElementById('btn-understood');

  function openInfo() {
    infoModal?.classList.remove('hidden');
    infoModal?.classList.add('flex');
  }

  function closeInfo() {
    infoModal?.classList.add('hidden');
    infoModal?.classList.remove('flex');
  }

  btnInfo?.addEventListener('click', openInfo);
  btnCloseInfo?.addEventListener('click', closeInfo);
  btnUnderstood?.addEventListener('click', closeInfo);

  // Colores Neón
  const colors = [
    { bright: '#00eaff', dark: '#004455' },
    { bright: '#f59e0b', dark: '#78350f' },
    { bright: '#f43f5e', dark: '#88133c' }
  ];
  
  let options = ['Toma 1', 'Toma 2', 'Reparte 2'];
  let currentRotation = 0;
  let spinCount = parseInt(localStorage.getItem(`ruleta_spin_${seed}`) || '0');

  // Sintetizador de Sonidos (Ligero y Offline)
  const audioCtx = typeof window !== 'undefined' ? new (window.AudioContext || (window as any).webkitAudioContext)() : null;

  function playTone(freq: number, type: OscillatorType, duration: number, volume = 0.1) {
    if (!audioCtx) return;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
    gain.gain.setValueAtTime(volume, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + duration);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start();
    osc.stop(audioCtx.currentTime + duration);
  }

  const sounds = {
    tick: () => playTone(800, 'sine', 0.05, 0.05),
    win: () => {
      if (audioCtx?.state === 'suspended') audioCtx.resume();
      [523.25, 659.25, 783.99, 1046.50].forEach((f, i) => {
        setTimeout(() => playTone(f, 'sine', 0.4, 0.1), i * 150);
      });
    }
  };

  // Cargar de LocalStorage
  const savedOptions = localStorage.getItem('juntapp_ruleta_options');
  if (savedOptions) {
    options = JSON.parse(savedOptions);
  }

  const createOptionInput = (value = '', index = 0) => {
    const div = document.createElement('div');
    div.className = 'flex items-center gap-2 group animate-in slide-in-from-left-2 duration-200';
    div.innerHTML = `
      <input 
        type="text" 
        class="flex-1 bg-black/40 border border-white/10 rounded-lg p-2 text-white font-inter text-xs focus:outline-none focus:border-vybe-secondary/50 transition-all option-input"
        placeholder="Opción ${index + 1}"
        value="${value}"
        maxlength="15"
      />
      <button class="remove-option p-2 text-vybe-text-muted hover:text-red-400 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    `;
    
    div.querySelector('.remove-option')?.addEventListener('click', () => {
      if (optionsContainer && optionsContainer.children.length > 2) {
        div.remove();
        updateOptionsFromUI(true);
      }
    });

    const input = div.querySelector('input');
    input?.addEventListener('input', () => {
      updateOptionsFromUI(true); 
    });

    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        addOptionBtn?.click();
      }
    });

    return div;
  };

  const renderInputs = () => {
    if (!optionsContainer) return;
    optionsContainer.innerHTML = '';
    options.forEach((opt, i) => {
      optionsContainer.appendChild(createOptionInput(opt, i));
    });
  };

  const updateOptionsFromUI = (reDrawWheel = true) => {
    const inputs = document.querySelectorAll('.option-input') as NodeListOf<HTMLInputElement>;
    options = Array.from(inputs).map(input => input.value).filter(v => v.trim() !== '');
    localStorage.setItem('juntapp_ruleta_options', JSON.stringify(options));
    if (reDrawWheel) drawWheel();
  };

  addOptionBtn?.addEventListener('click', () => {
    if (optionsContainer && optionsContainer.children.length < 20) {
      const newInput = createOptionInput('', optionsContainer.children.length);
      optionsContainer.appendChild(newInput);
      optionsContainer.scrollTop = optionsContainer.scrollHeight;
      newInput.querySelector('input')?.focus();
    }
  });

  const btnLoadParty = document.getElementById('btn-load-party-players');
  btnLoadParty?.addEventListener('click', () => {
    const party = getPlayers();
    if (party.length >= 2) {
      options = [...party.slice(0, 20)];
      localStorage.setItem('juntapp_ruleta_options', JSON.stringify(options));
      renderInputs();
      drawWheel();
      sounds.tick();
    } else {
      // Si aún no hay amigos configurados, abrir el modal de grupo
      const modalTrigger = document.querySelector('[data-open-party-modal]') as HTMLElement;
      if (modalTrigger) {
        modalTrigger.click();
      } else {
        const modal = document.getElementById('party-players-modal');
        modal?.classList.remove('hidden');
        modal?.classList.add('flex');
      }
    }
  });

  // Inicializar Interfaz
  renderInputs();
  
  // Utilidades para SVG Math
  function polarToCartesian(centerX: number, centerY: number, radius: number, angleInDegrees: number) {
    const angleInRadians = (angleInDegrees - 90) * Math.PI / 180.0;
    return {
      x: centerX + (radius * Math.cos(angleInRadians)),
      y: centerY + (radius * Math.sin(angleInRadians))
    };
  }

  function describeSlice(x: number, y: number, innerRadius: number, outerRadius: number, startAngle: number, endAngle: number) {
    const p1 = polarToCartesian(x, y, outerRadius, startAngle);
    const p2 = polarToCartesian(x, y, outerRadius, endAngle);
    const p3 = polarToCartesian(x, y, innerRadius, endAngle);
    const p4 = polarToCartesian(x, y, innerRadius, startAngle);

    const largeArcFlag = endAngle - startAngle <= 180 ? "0" : "1";

    return [
      "M", p1.x, p1.y,
      "A", outerRadius, outerRadius, 0, largeArcFlag, 1, p2.x, p2.y,
      "L", p3.x, p3.y,
      "A", innerRadius, innerRadius, 0, largeArcFlag, 0, p4.x, p4.y,
      "Z"
    ].join(" ");
  }

  const drawWheel = () => {
    if (options.length === 0) return;
    
    const sliceAngle = 360 / options.length;
    let svgHTML = `<svg viewBox="0 0 1000 1000" class="w-full h-full drop-shadow-2xl">`;
    
    // Definimos los filtros y gradientes para el efecto Opalino
    svgHTML += `<defs>`;
    // Gradiente Metálico para el Marco (Acero Pulido)
    svgHTML += `
      <linearGradient id="metal-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#f3f4f6" />
        <stop offset="20%" stop-color="#9ca3af" />
        <stop offset="50%" stop-color="#ffffff" />
        <stop offset="80%" stop-color="#9ca3af" />
        <stop offset="100%" stop-color="#d1d5db" />
      </linearGradient>
    `;
    // Filtro para el reflejo neón en el marco metálico
    svgHTML += `
      <filter id="rim-glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="15" result="blur" />
      </filter>
    `;
    colors.forEach((palette, i) => {
      // Filtro de Resplandor Neón
      svgHTML += `
        <filter id="neon-glow-${i}" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="6" result="blur1" />
          <feGaussianBlur stdDeviation="12" result="blur2" />
          <feGaussianBlur stdDeviation="25" result="blur3" />
          <feMerge>
            <feMergeNode in="blur3" />
            <feMergeNode in="blur2" />
            <feMergeNode in="blur1" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      `;
      // Gradiente para el Policarbonato Opalino (Blanquecino en el centro)
      svgHTML += `
        <radialGradient id="opal-grad-${i}" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="0.3" />
          <stop offset="60%" stop-color="${palette.bright}" stop-opacity="0.4" />
          <stop offset="100%" stop-color="${palette.dark}" stop-opacity="0.6" />
        </radialGradient>
      `;
    });
    svgHTML += `</defs>`;

    // CIRCULO BASE (Para asegurar que no se vea negro el fondo)
    svgHTML += `<circle cx="500" cy="500" r="498" fill="#374151" />`;

    // 1. Fondos de Policarbonato Opalino y REFLEJOS EN EL MARCO
    options.forEach((_, index) => {
      const startAngle = index * sliceAngle;
      const endAngle = (index + 1) * sliceAngle;
      
      let colorIndex = index % colors.length;
      if (index === options.length - 1 && options.length % colors.length === 1 && options.length > colors.length) {
         colorIndex = (colorIndex + 1) % colors.length;
      }
      
      const palette = colors[colorIndex];
      const bgPath = describeSlice(500, 500, 0, 500, startAngle, endAngle);
      
      // Capa Base Opalina (SIN BORDE NEGRO)
      svgHTML += `<path d="${bgPath}" fill="url(#opal-grad-${colorIndex})" />`;

      // REFLEJO NEÓN EN EL MARCO (Ajustado a la pared interior r=485 a 500)
      const reflectionPath = describeSlice(500, 500, 485, 505, startAngle, endAngle);
      svgHTML += `
        <path d="${reflectionPath}" 
              fill="${palette.bright}" 
              opacity="0.5" 
              filter="url(#rim-glow)" />
      `;
    });


    // 2. Tubos Neón con Efecto de Núcleo Caliente
    options.forEach((opt, index) => {
      const startAngle = index * sliceAngle;
      const endAngle = (index + 1) * sliceAngle;
      const midAngle = startAngle + (sliceAngle / 2);
      
      let colorIndex = index % colors.length;
      if (index === options.length - 1 && options.length % colors.length === 1 && options.length > colors.length) {
         colorIndex = (colorIndex + 1) % colors.length;
      }
      
      const palette = colors[colorIndex];
      const filterId = `url(#neon-glow-${colorIndex})`;
      const gap = Math.max(1.5, Math.min(4, sliceAngle * 0.15)); 
      
      // Neón naciendo justo al borde del botón (90)
      const neonPath = describeSlice(500, 500, 90, 470, startAngle + gap, endAngle - gap);
      
      // Trazo de Color Base (Grosor aumentado a 12)
      svgHTML += `<path d="${neonPath}" fill="none" stroke="${palette.bright}" stroke-width="12" filter="${filterId}" />`;
      // Trazo de Núcleo (Grosor aumentado a 4)
      svgHTML += `<path d="${neonPath}" fill="none" stroke="white" stroke-width="4" stroke-linecap="round" opacity="0.9" />`;
      
      // Texto Neón (Orientación Radial/Vertical)
      const displayOpt = opt.length > 10 ? opt.substring(0, 10) + '...' : opt;
      const textRadius = 290; 
      
      // Limitamos el alto de la fuente para que no choque cerca del centro
      const innerArcWidth = 2 * 140 * Math.sin((sliceAngle / 2) * Math.PI / 180);
      let maxFontSize = innerArcWidth * 0.9;
      
      // Limitamos según el largo de la palabra
      const maxRadialLength = 300; 
      let fontSizeByLength = maxRadialLength / Math.max(1, displayOpt.length * 0.6);
      
      let fontSize = Math.min(45, Math.min(maxFontSize, fontSizeByLength)) * 0.9;
      fontSize = Math.max(10, fontSize);
      
      // Rotamos el texto -90 grados sobre su propio centro para que se lea desde el centro hacia afuera
      const rotateTransform = `rotate(${midAngle}, 500, 500) rotate(-90, 500, ${500 - textRadius})`;
      
      svgHTML += `
        <text x="500" y="${500 - textRadius}" 
              fill="${palette.bright}" 
              font-family="sans-serif" 
              font-size="${fontSize}" 
              font-weight="900" 
              text-anchor="middle" 
              alignment-baseline="middle"
              transform="${rotateTransform}"
              filter="${filterId}"
              letter-spacing="2">
          ${displayOpt.toUpperCase()}
        </text>
        <text x="500" y="${500 - textRadius}" 
              fill="white" 
              font-family="sans-serif" 
              font-size="${fontSize}" 
              font-weight="900" 
              text-anchor="middle" 
              alignment-baseline="middle"
              transform="${rotateTransform}"
              opacity="0.5"
              letter-spacing="2">
          ${displayOpt.toUpperCase()}
        </text>
      `;
    });

    // 3. Dibujamos los rayos de metal (Spokes) por encima de todo
    options.forEach((_, index) => {
      const startAngle = index * sliceAngle;
      // Los rayos nacen en 90 para estar pegados al botón y terminan en el marco (488)
      const spokeP1 = polarToCartesian(500, 500, 90, startAngle);
      const spokeP2 = polarToCartesian(500, 500, 488, startAngle);
      
      // Sombra del rayo metálico
      svgHTML += `
        <line x1="${spokeP1.x}" y1="${spokeP1.y}" x2="${spokeP2.x}" y2="${spokeP2.y}" 
              stroke="#000" stroke-width="14" stroke-linecap="round" opacity="0.4" />
      `;
      // Rayo metálico principal
      svgHTML += `
        <line x1="${spokeP1.x}" y1="${spokeP1.y}" x2="${spokeP2.x}" y2="${spokeP2.y}" 
              stroke="#9ca3af" stroke-width="8" stroke-linecap="round" />
      `;
      // Brillo interior del metal
      svgHTML += `
        <line x1="${spokeP1.x}" y1="${spokeP1.y}" x2="${spokeP2.x}" y2="${spokeP2.y}" 
              stroke="#e5e7eb" stroke-width="2" stroke-linecap="round" />
      `;
    });

    // 4. MARCO METÁLICO FINAL (Acero Pulido con Gradiente)
    svgHTML += `
      <circle cx="500" cy="500" r="490" fill="none" stroke="url(#metal-grad)" stroke-width="16" />
      <circle cx="500" cy="500" r="482" fill="none" stroke="#4b5563" stroke-width="4" />
      <circle cx="500" cy="500" r="498" fill="none" stroke="#1f2937" stroke-width="2" />
    `;

    // Círculo decorativo central GRIS METÁLICO (Ajustado)
    svgHTML += `
      <circle cx="500" cy="500" r="90" fill="#1f2937" stroke="#9ca3af" stroke-width="6" />
    `;

    svgHTML += `</svg>`;
    
    if (wheel) {
      wheel.innerHTML = svgHTML;
    }
  };

  drawWheel();




  const performSpin = () => {
    if (!wheel || options.length === 0) return;
    
    // Check both buttons
    if (btnSpin?.getAttribute('disabled') === 'true' || btnSpinAlt?.getAttribute('disabled') === 'true') return;

    // Disable both
    [btnSpin, btnSpinAlt].forEach(btn => {
      btn?.setAttribute('disabled', 'true');
      btn?.classList.add('opacity-50');
    });

    if(resultDisplay) resultDisplay.innerText = 'Girando...';

    spinCount++;
    localStorage.setItem(`ruleta_spin_${seed}`, spinCount.toString());
    
    const randomFunc = createSeededRandom(seed + '_ruleta_' + spinCount);
    const randValue = randomFunc();
    
    const winningIndex = Math.floor(randValue * options.length);
    const sliceAngle = 360 / options.length;
    const sliceCenterAngle = winningIndex * sliceAngle + (sliceAngle / 2);
    const extraSpins = 5 * 360;
    const targetRotation = extraSpins + (360 - sliceCenterAngle);
    const currentMod = currentRotation % 360;
    let rotationDiff = targetRotation - currentMod;
    if (rotationDiff < extraSpins) {
      rotationDiff += extraSpins;
    }
    
    currentRotation += rotationDiff;
    wheel.style.transform = `rotate(${currentRotation}deg)`;

    // Efecto de sonido sincronizado
    if (audioCtx?.state === 'suspended') audioCtx.resume();
    let lastTickAngle = 0;
    
    // Monitorear el giro para los "ticks"
    const startTime = Date.now();
    const duration = 4000;
    const tickLoop = setInterval(() => {
      const elapsed = Date.now() - startTime;
      if (elapsed > duration) {
        clearInterval(tickLoop);
        return;
      }

      // Obtener el ángulo actual desde la matriz de transformación de CSS
      const style = window.getComputedStyle(wheel!);
      const matrix = new DOMMatrix(style.transform);
      const angle = Math.atan2(matrix.b, matrix.a) * (180 / Math.PI);
      const normalizedAngle = angle < 0 ? angle + 360 : angle;

      if (Math.abs(normalizedAngle - lastTickAngle) > (sliceAngle * 0.8)) {
        sounds.tick();
        lastTickAngle = normalizedAngle;
      }
    }, 16);

    setTimeout(() => {
      sounds.win();
      if(resultDisplay) {
        resultDisplay.innerText = options[winningIndex];
        resultDisplay.classList.remove('neon-text-secondary');
        void resultDisplay.offsetWidth;
        resultDisplay.classList.add('neon-text-secondary');
      }
      
      // Enable both
      [btnSpin, btnSpinAlt].forEach(btn => {
        btn?.removeAttribute('disabled');
        btn?.classList.remove('opacity-50');
      });
    }, 4000);
  };

  btnSpin?.addEventListener('click', performSpin);
  btnSpinAlt?.addEventListener('click', performSpin);
</script>

