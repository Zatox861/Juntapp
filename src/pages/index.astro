---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Juntapp | Noches Inolvidables">
  <div class="px-4 md:px-12 py-16 md:py-[80px]">
    <!-- Hero Section -->
    <section class="flex flex-col md:flex-row items-center mb-[120px] md:gap-[100px]">
      <!-- Text Content -->
      <div class="w-full md:w-5/12 flex flex-col gap-4 z-20">
        <div class="inline-flex items-center gap-2 bg-surface-container/80 border border-white/10 backdrop-blur-md px-4 py-2 rounded-full w-max mb-2">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          <span class="font-label-sm text-label-sm text-primary" id="user-count">+1.200 jugando ahora</span>
        </div>
        <h1 class="font-display-lg text-4xl md:text-5xl text-on-background tracking-tighter">
          Juegos rápidos para noches <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary glow-effect">inolvidables</span>.
        </h1>
        <p class="font-body-lg text-lg text-on-surface-variant mt-2 max-w-[90%]">
          Conecta, ríe y descubre verdades incómodas con tu círculo <span class="text-primary font-bold">totalmente gratis</span> y a un tap de distancia.
        </p>
        <div class="flex flex-wrap items-center gap-4 mt-6">
          <a href="/play" class="bg-gradient-to-r from-primary to-secondary text-white font-black font-headline-md text-xl py-4 px-10 rounded-xl shadow-[0_0_30px_rgba(168,85,247,0.3)] hover:shadow-[0_0_50px_rgba(168,85,247,0.5)] transition-all duration-300 hover:-translate-y-1 text-center">
            Empezar Party
          </a>
          <button id="btn-join" class="bg-surface-container hover:bg-surface-variant text-on-surface font-headline-md text-xl py-3 px-8 rounded-xl border border-white/5 transition-all duration-300 font-semibold cursor-pointer">
            Tengo un código
          </button>
        </div>
      </div>

      <!-- Visual Composition -->
      <div class="w-full md:w-7/12 relative mt-12 md:mt-0 min-h-[400px] md:min-h-[500px]">
        <!-- Main Image -->
        <div class="absolute inset-0 md:inset-auto md:right-0 md:top-1/2 md:-translate-y-1/2 w-full md:w-[110%] aspect-video md:aspect-[4/3] rounded-2xl md:rounded-[32px] overflow-hidden border border-white/10 shadow-2xl z-10">
          <img alt="Grupo de amigos riendo iluminados cálidamente por una pantalla" class="w-full h-full object-cover" src="/img/hero-party.jpg">
          <div class="absolute inset-0 bg-gradient-to-t from-background/80 via-transparent to-transparent"></div>
        </div>

        <!-- Floating Glass Card 1: Verdad o Reto -->
        <div class="absolute -top-4 -left-4 md:-left-8 bg-surface-container/60 backdrop-blur-xl border border-white/10 p-3 px-5 rounded-2xl shadow-2xl z-30 flex items-center gap-3 animate-[bounce_4s_ease-in-out_infinite]">
          <div class="w-10 h-10 bg-primary/20 rounded-full flex items-center justify-center text-xl border border-primary/30 shadow-[0_0_15px_rgba(168,85,247,0.3)]">
            😂
          </div>
          <div>
            <p class="font-label-sm text-sm text-on-surface font-bold">Verdad o Reto</p>
            <p class="font-label-sm text-[10px] text-purple-300 tracking-wider uppercase font-medium">Ronda de confesiones</p>
          </div>
        </div>

        <!-- Floating Glass Card 2: ¿Quién es más? -->
        <div class="absolute top-[60%] -right-4 md:-right-8 bg-surface-container/60 backdrop-blur-xl border border-white/10 p-3 px-5 rounded-2xl shadow-2xl z-30 flex items-center gap-3 animate-[bounce_5s_ease-in-out_infinite] delay-700">
          <div class="w-10 h-10 bg-tertiary/20 rounded-full flex items-center justify-center text-xl border border-tertiary/30 shadow-[0_0_15px_rgba(244,63,94,0.3)]">
            😬
          </div>
          <div>
            <p class="font-label-sm text-sm text-on-surface font-bold">¿Quién es más...?</p>
            <p class="font-label-sm text-[10px] text-rose-300 tracking-wider uppercase font-medium">Vota por tus amigos</p>
          </div>
        </div>

        <!-- Floating Reaction -->
        <div class="absolute top-1/4 right-4 bg-white/10 backdrop-blur-md rounded-full p-2 z-20 shadow-lg border border-white/5 animate-[pulse_3s_ease-in-out_infinite]">
          <span class="text-2xl">🎉</span>
        </div>
      </div>
    </section>

    <!-- Featured Games Section -->
    <section class="flex flex-col gap-8 mb-20">
      <div class="flex justify-between items-end">
        <div>
          <h2 class="font-headline-md text-3xl font-bold text-on-background tracking-tight">Juegos Destacados</h2>
          <p class="font-body-md text-on-surface-variant mt-1">Elige tu vibra para esta noche.</p>
        </div>
        <a class="text-primary hover:text-tertiary flex items-center gap-1 font-label-sm text-sm transition-colors uppercase tracking-widest font-semibold" href="/play">
          Ver todos <span class="material-symbols-outlined text-sm">arrow_forward</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card 1: Verdad o Reto -->
        <a href="/juegos/verdad-reto" class="group relative bg-surface-container rounded-[24px] border border-white/5 overflow-hidden hover:border-primary/50 transition-all duration-500 cursor-pointer h-[350px] flex flex-col justify-end">
          <img alt="Vista aérea de amigos sentados en círculo jugando verdad o reto con una botella en una alfombra" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="/img/cover_verdad_reto.png">
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent"></div>
          <div class="relative z-10 p-6">
            <div class="bg-primary/20 text-primary w-max px-3 py-1 rounded-full font-label-sm text-[10px] mb-3 backdrop-blur-md border border-primary/30 uppercase tracking-widest font-bold">
              Top #1 Social
            </div>
            <h3 class="font-headline-md text-2xl font-bold text-on-background mb-1">Verdad o Reto</h3>
            <p class="font-body-md text-on-surface-variant line-clamp-2">Preguntas que no te atreverías a hacer en público. Preparate para las confesiones.</p>
          </div>
        </a>

        <!-- Card 2: Ruleta -->
        <a href="/juegos/ruleta" class="group relative bg-surface-container rounded-[24px] border border-white/5 overflow-hidden hover:border-tertiary/50 transition-all duration-500 cursor-pointer h-[350px] flex flex-col justify-end">
          <img alt="Ruleta neón futurista" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="/img/cover_ruleta.png">
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent"></div>
          <div class="relative z-10 p-6">
            <div class="bg-tertiary/20 text-tertiary w-max px-3 py-1 rounded-full font-label-sm text-[10px] mb-3 backdrop-blur-md border border-tertiary/30 uppercase tracking-widest font-bold">
              Alta Energía
            </div>
            <h3 class="font-headline-md text-2xl font-bold text-on-background mb-1">Ruleta de la Suerte</h3>
            <p class="font-body-md text-on-surface-variant line-clamp-2">Retos absurdos y penalizaciones ridículas. Nadie se salva de la suerte.</p>
          </div>
        </a>

        <!-- Card 3: ¿Quién es más probable? -->
        <a href="/juegos/quien-es" class="group relative bg-surface-container rounded-[24px] border border-white/5 overflow-hidden hover:border-secondary/50 transition-all duration-500 cursor-pointer h-[350px] flex flex-col justify-end">
          <img alt="Siluetas en fiesta neón señalando" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="/img/cover_quien_es.png">
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent"></div>
          <div class="relative z-10 p-6">
            <div class="bg-secondary/20 text-secondary w-max px-3 py-1 rounded-full font-label-sm text-[10px] mb-3 backdrop-blur-md border border-secondary/30 uppercase tracking-widest font-bold">
              Solo Valientes
            </div>
            <h3 class="font-headline-md text-2xl font-bold text-on-background mb-1">¿Quién es más...?</h3>
            <p class="font-body-md text-on-surface-variant line-clamp-2">Vota quién es más probable que... y descubre lo que realmente piensan de ti.</p>
          </div>
        </a>

        <!-- Card 4: Bingo -->
        <a href="/bingo-lobby" class="group relative bg-surface-container rounded-[24px] border border-white/5 overflow-hidden hover:border-primary/50 transition-all duration-500 cursor-pointer h-[350px] flex flex-col justify-end">
          <img alt="Perspectiva en primera persona sosteniendo un cartón de Bingo con amigos de fondo" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="/img/cover_bingo.png">
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent"></div>
          <div class="relative z-10 p-6">
            <div class="bg-primary/20 text-primary w-max px-3 py-1 rounded-full font-label-sm text-[10px] mb-3 backdrop-blur-md border border-primary/30 uppercase tracking-widest font-bold">
              Clásico Renacido
            </div>
            <h3 class="font-headline-md text-2xl font-bold text-on-background mb-1">Bingo</h3>
            <p class="font-body-md text-on-surface-variant line-clamp-2">Cartones dinámicos y diversión clásica. Grita ¡Bingo! antes que los demás.</p>
          </div>
        </a>

        <!-- Card 5: Quién sabe más -->
        <a href="/juegos/quien-sabe-mas" class="group relative bg-surface-container rounded-[24px] border border-white/5 overflow-hidden hover:border-secondary/50 transition-all duration-500 cursor-pointer h-[350px] flex flex-col justify-end">
          <img alt="Amigos jugando trivia en un quincho de asados" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="/img/cover_quien_sabe_mas.png">
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent"></div>
          <div class="relative z-10 p-6">
            <div class="bg-secondary/20 text-secondary w-max px-3 py-1 rounded-full font-label-sm text-[10px] mb-3 backdrop-blur-md border border-secondary/30 uppercase tracking-widest font-bold">
              Desafío Mental
            </div>
            <h3 class="font-headline-md text-2xl font-bold text-on-background mb-1">¿Quién Sabe Más?</h3>
            <p class="font-body-md text-on-surface-variant line-clamp-2">Pon a prueba a tus amigos en rondas de trivia. El que falla, paga penitencia.</p>
          </div>
        </a>

        <!-- Card 6: Mímica -->
        <a href="/juegos/mimica" class="group relative bg-surface-container rounded-[24px] border border-white/5 overflow-hidden hover:border-tertiary/50 transition-all duration-500 cursor-pointer h-[350px] flex flex-col justify-end">
          <img alt="Persona haciendo gestos de mímica con amigos riendo en un living de fondo" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="/img/cover_mimica.png">
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent"></div>
          <div class="relative z-10 p-6">
            <div class="bg-tertiary/20 text-tertiary w-max px-3 py-1 rounded-full font-label-sm text-[10px] mb-3 backdrop-blur-md border border-tertiary/30 uppercase tracking-widest font-bold">
              Risas Garantizadas
            </div>
            <h3 class="font-headline-md text-2xl font-bold text-on-background mb-1">Mímica Extrema</h3>
            <p class="font-body-md text-on-surface-variant line-clamp-2">Adivina la palabra oculta. Las actuaciones vergonzosas están aseguradas.</p>
          </div>
        </a>
      </div>
    </section>
  </div>

  <!-- Footer Component -->
  <footer class="bg-surface-container-lowest full-width mt-auto border-t border-white/5">
    <div class="flex flex-col md:flex-row justify-between items-center px-4 md:px-12 py-8 gap-6 max-w-[1280px] mx-auto w-full">
      <div class="font-display-lg text-2xl font-bold text-primary tracking-tighter">
        JUNTAPP
      </div>
      <ul class="flex flex-wrap justify-center gap-6 font-body-md text-sm">
        <li><a class="text-on-surface-variant hover:text-tertiary transition-colors opacity-80 hover:opacity-100 block" href="#">Términos</a></li>
        <li><a class="text-on-surface-variant hover:text-tertiary transition-colors opacity-80 hover:opacity-100 block" href="#">Privacidad</a></li>
        <li><a class="text-on-surface-variant hover:text-tertiary transition-colors opacity-80 hover:opacity-100 block" href="#">Contacto</a></li>
      </ul>
      <div class="text-tertiary font-body-md text-sm text-center md:text-right opacity-80">
        © 2025 Juntapp Social Gaming.
      </div>
    </div>
  </footer>

  <!-- Modal unirse (Hidden) -->
  <dialog id="join-modal" class="bg-transparent backdrop:bg-black/80 backdrop:backdrop-blur-sm p-0 m-auto rounded-2xl w-full max-w-sm open:flex flex-col border border-white/10 shadow-2xl">
    <div class="glass-panel p-8 rounded-2xl flex flex-col w-full relative">
      <button id="close-modal" class="absolute top-4 right-4 text-on-surface-variant hover:text-white transition-colors">✕</button>
      <h2 class="text-2xl font-geist font-bold text-white mb-2">Ingresa el código</h2>
      <p class="text-on-surface-variant text-sm mb-6">Si no tienes el código QR, pide el código de 4 letras al anfitrión.</p>
      
      <input type="text" id="room-code" placeholder="Ej: ABCD" class="w-full bg-surface-container-highest border border-white/10 rounded-lg px-4 py-3 text-white text-center text-2xl font-mono uppercase tracking-widest focus:outline-none focus:border-primary transition-all mb-4" maxlength="4" />
      
      <button id="submit-join" class="w-full bg-primary text-on-primary py-3 rounded-lg font-bold hover:bg-primary/90 transition-colors">Entrar a la Sala</button>
    </div>
  </dialog>
</Layout>


<script>
  // Algoritmo de Ciclo Solar para el contador de usuarios
  const userCountEl = document.getElementById('user-count');
  let currentDisplayUsers = 0;

  function updateDynamicCounter() {
    const now = new Date();
    // Forzamos el uso de la hora estándar de Latam (GMT-3)
    const latamHour = (now.getUTCHours() - 3 + 24) % 24;
    const latamMinutes = now.getUTCMinutes();
    
    const timeValue = latamHour + (latamMinutes / 60);
    const intensity = (Math.cos((timeValue - 23) * Math.PI / 12) + 1) / 2;
    
    const minCount = 870;
    const maxCount = 1625;
    const targetBase = minCount + (maxCount - minCount) * intensity;
    
    if (currentDisplayUsers === 0) {
      currentDisplayUsers = targetBase + (Math.random() * 40 - 20);
    }
    
    const fluctuation = Math.floor(Math.random() * 20) - 8;
    currentDisplayUsers = Math.max(minCount, Math.min(maxCount, currentDisplayUsers + fluctuation));
    
    const drift = (targetBase - currentDisplayUsers) * 0.1;
    currentDisplayUsers += drift;

    if (userCountEl) {
      userCountEl.textContent = `+${Math.floor(currentDisplayUsers).toLocaleString('de-DE')} jugando ahora`;
    }
    
    setTimeout(updateDynamicCounter, 3000 + Math.random() * 3000);
  }

  updateDynamicCounter();

  const btnJoin = document.getElementById('btn-join');
  const modal = document.getElementById('join-modal') as HTMLDialogElement;
  const closeModal = document.getElementById('close-modal');
  const submitJoin = document.getElementById('submit-join');
  const roomCodeInput = document.getElementById('room-code') as HTMLInputElement;

  btnJoin?.addEventListener('click', () => {
    modal?.showModal();
    roomCodeInput?.focus();
  });

  closeModal?.addEventListener('click', () => {
    modal?.close();
  });

  submitJoin?.addEventListener('click', () => {
    const code = roomCodeInput?.value.toUpperCase();
    if(code && code.length === 4) {
      window.location.href = `/bingo-lobby?seed=${code}`;
    }
  });

  roomCodeInput?.addEventListener('keyup', (e) => {
    if(e.key === 'Enter') {
      submitJoin?.click();
    }
  });
</script>
