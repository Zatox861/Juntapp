---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contacto y Soporte | Juntapp" 
  description="Ponte en contacto con el equipo de Juntapp. Sugerencias de juegos, preguntas, reporte de errores o alianzas."
>
  <div class="py-10 md:py-16 px-4 max-w-4xl mx-auto w-full">
    <!-- Header -->
    <div class="mb-10 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-pink-500/10 border border-pink-500/20 text-pink-400 text-xs font-bold uppercase tracking-wider mb-4">
        <span>💬 Soporte y Comunidad</span>
      </div>
      <h1 class="font-display-lg text-3xl md:text-5xl font-black text-white mb-3 tracking-tight">
        ¿Cómo podemos <span class="text-transparent bg-clip-text bg-gradient-to-r from-pink-400 via-purple-400 to-cyan-400">ayudarte?</span>
      </h1>
      <p class="text-zinc-400 text-sm md:text-base max-w-2xl mx-auto">
        ¿Tienes una idea para un nuevo juego, quieres sugerir preguntas para Yo Nunca o encontraste algún error? ¡Nos encantaría escucharte!
      </p>
    </div>

    <!-- Canales de Contacto Directos -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
      
      <!-- Card 1: Correo Oficial -->
      <div class="glass-panel rounded-2xl p-6 border border-white/10 hover:border-primary/50 transition-all flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-primary/20 text-primary flex items-center justify-center text-xl mb-4">
            ✉️
          </div>
          <h2 class="text-lg font-bold text-white mb-1">Correo Directo</h2>
          <p class="text-zinc-400 text-xs md:text-sm mb-4 leading-relaxed">
            Escríbenos para cualquier duda general, comentarios sobre la plataforma o propuestas de colaboración.
          </p>
        </div>
        <div class="flex items-center gap-2">
          <a 
            href="mailto:contacto@juntapp.net" 
            class="flex-1 text-center py-2.5 px-4 rounded-xl bg-primary text-black font-bold text-xs md:text-sm hover:bg-primary/90 transition-colors shadow-[0_0_20px_rgba(168,85,247,0.3)]"
          >
            Escribir a contacto@juntapp.net
          </a>
          <button 
            type="button"
            id="copy-email-btn"
            class="py-2.5 px-3 rounded-xl bg-white/5 border border-white/10 text-zinc-300 hover:text-white hover:bg-white/10 transition-colors text-xs cursor-pointer"
            title="Copiar correo"
          >
            📋
          </button>
        </div>
        <div id="copy-feedback" class="text-[11px] text-green-400 font-semibold mt-2 hidden text-center">
          ✓ Correo copiado al portapapeles
        </div>
      </div>

      <!-- Card 2: Sugerir Preguntas / Penitencias -->
      <div class="glass-panel rounded-2xl p-6 border border-white/10 hover:border-cyan-400/50 transition-all flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-cyan-400/20 text-cyan-400 flex items-center justify-center text-xl mb-4">
            💡
          </div>
          <h2 class="text-lg font-bold text-white mb-1">Envía tus Preguntas y Juegos</h2>
          <p class="text-zinc-400 text-xs md:text-sm mb-4 leading-relaxed">
            Las mejores preguntas y penitencias de Juntapp provienen de anécdotas reales de juntas de amigos.
          </p>
        </div>
        <a 
          href="mailto:contacto@juntapp.net?subject=Sugerencia%20de%20Juego%20o%20Pregunta%20para%20Juntapp" 
          class="text-center py-2.5 px-4 rounded-xl bg-white/5 border border-cyan-400/30 text-cyan-400 font-bold text-xs md:text-sm hover:bg-cyan-400/10 transition-colors"
        >
          Sugerir Ideas o Dinámicas
        </a>
      </div>

    </div>

    <!-- Preguntas Frecuentes Rápidas (FAQ) -->
    <div class="glass-panel rounded-3xl p-6 md:p-10 border border-white/10 space-y-6">
      <h2 class="text-xl md:text-2xl font-bold text-white flex items-center gap-2">
        <span>❓</span> Preguntas Frecuentes
      </h2>

      <div class="divide-y divide-white/5 space-y-4">
        
        <div class="pt-4 first:pt-0">
          <h3 class="text-white font-semibold text-sm md:text-base mb-1">
            ¿Juntapp es 100% gratuito?
          </h3>
          <p class="text-zinc-400 text-xs md:text-sm leading-relaxed">
            Sí, todos nuestros juegos son completamente gratuitos y accesibles para todos los participantes sin pagos ocultos ni suscripciones obligatorias.
          </p>
        </div>

        <div class="pt-4">
          <h3 class="text-white font-semibold text-sm md:text-base mb-1">
            ¿Necesito descargar una app pesada desde la App Store o Play Store?
          </h3>
          <p class="text-zinc-400 text-xs md:text-sm leading-relaxed">
            No. Juntapp está construida como una aplicación web ultrarrápida. Solo abres <strong class="text-white">juntapp.net</strong> en Safari, Chrome o tu navegador favorito y listo. Si deseas, puedes pulsar "Añadir a pantalla de inicio" para tenerla como app nativa con un solo toque.
          </p>
        </div>

        <div class="pt-4">
          <h3 class="text-white font-semibold text-sm md:text-base mb-1">
            ¿Cómo funciona el Gestor de Grupo de Amigos?
          </h3>
          <p class="text-zinc-400 text-xs md:text-sm leading-relaxed">
            En la barra superior verás el botón <strong class="text-primary">👥 Grupo</strong>. Al ingresar los nombres de tus amigos, se sincronizan automáticamente con juegos como Verdad o Reto, Ruleta, Mímica y El Impostor para que los turnos salgan con sus nombres reales.
          </p>
        </div>

        <div class="pt-4">
          <h3 class="text-white font-semibold text-sm md:text-base mb-1">
            ¿Se apaga la pantalla de mi celular mientras jugamos?
          </h3>
          <p class="text-zinc-400 text-xs md:text-sm leading-relaxed">
            No. Juntapp incluye tecnología de bloqueo de suspensión de pantalla automática (Screen Wake Lock) para que el teléfono no se bloquee mientras están leyendo prendas o girando la ruleta.
          </p>
        </div>

      </div>
    </div>

    <!-- Navegación inferior rápida -->
    <div class="mt-8 flex flex-wrap justify-between items-center gap-4 text-xs md:text-sm text-zinc-400">
      <a href="/" class="flex items-center gap-1.5 hover:text-white transition-colors">
        <span>←</span> Volver al Inicio
      </a>
      <div class="flex items-center gap-4">
        <a href="/terminos" class="hover:text-primary transition-colors underline underline-offset-4">
          Términos y Condiciones
        </a>
        <span>•</span>
        <a href="/privacidad" class="hover:text-cyan-400 transition-colors underline underline-offset-4">
          Política de Privacidad
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyFeedback = document.getElementById('copy-feedback');

  if (copyBtn && copyFeedback) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('contacto@juntapp.net');
        copyFeedback.classList.remove('hidden');
        setTimeout(() => {
          copyFeedback.classList.add('hidden');
        }, 3000);
      } catch (e) {
        // Fallback
        const textarea = document.createElement('textarea');
        textarea.value = 'contacto@juntapp.net';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
        copyFeedback.classList.remove('hidden');
        setTimeout(() => {
          copyFeedback.classList.add('hidden');
        }, 3000);
      }
    });
  }
</script>
