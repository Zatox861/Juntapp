---
import Logo from './Logo.astro';
---

<footer class="bg-surface-container-lowest full-width mt-auto border-t border-white/5 relative z-20">
  <div class="flex flex-col md:flex-row justify-between items-center px-4 md:px-12 py-8 gap-6 max-w-[1280px] mx-auto w-full">
    <!-- Brand -->
    <a href="/" class="hover:opacity-90 transition-opacity" title="Ir al inicio de Juntapp">
      <Logo size="sm" />
    </a>

    <!-- Enlaces Legales y de Navegación -->
    <ul class="flex flex-wrap justify-center items-center gap-6 font-body-md text-sm">
      <li>
        <a class="text-on-surface-variant hover:text-white transition-colors opacity-80 hover:opacity-100" href="/play">
          Juegos
        </a>
      </li>
      <li>
        <a class="text-on-surface-variant hover:text-white transition-colors opacity-80 hover:opacity-100" href="/terminos">
          Términos
        </a>
      </li>
      <li>
        <a class="text-on-surface-variant hover:text-white transition-colors opacity-80 hover:opacity-100" href="/privacidad">
          Privacidad
        </a>
      </li>
      <li>
        <a class="text-on-surface-variant hover:text-white transition-colors opacity-80 hover:opacity-100" href="/contacto">
          Contacto
        </a>
      </li>
    </ul>

    <!-- Copyright & Dominio -->
    <div class="text-tertiary font-body-md text-sm text-center md:text-right opacity-80">
      © 2026 <span class="text-white font-semibold">Juntapp</span> • juntapp.net
    </div>
  </div>
</footer>
